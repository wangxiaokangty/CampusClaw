# 复制为 .env；先替换密码，再将同一密码填入连接地址。
POSTGRES_USER=campusclaw
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_DB=campusclaw
CAMPUSCLAW_DATABASE_URL=postgresql+psycopg://campusclaw:replace-with-your-local-password@db:5432/campusclaw
CAMPUSCLAW_JWT_SECRET=replace-with-your-existing-or-new-secret
